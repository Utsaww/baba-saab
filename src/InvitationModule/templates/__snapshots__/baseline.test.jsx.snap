55684-a54a2f03665f?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Photo 3"></button><button type="button" aria-label="Open Photo 4"><img src="https://images.unsplash.com/photo-1623788452350-4c8596ff40bb?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Photo 4"></button><button type="button" aria-label="Open Photo 5"><img src="https://images.unsplash.com/photo-1595407753234-0882f1e77954?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Photo 5"></button><button type="button" aria-label="Open Photo 6"><img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Photo 6"></button></div></section><section class="" data-section="rsvp" aria-labelledby="sec-rsvp"><h2 id="sec-rsvp"><span>RSVP<span class="hiLine" lang="hi">उपस्थिति की पुष्टि</span></span></h2><div role="status" aria-live="polite"></div><form novalidate=""><p><span>Kindly respond by<span class="hiLine" lang="hi">कृपया उत्तर दें</span></span> Sunday, 31 January 2027</p><label><span>Name<span class="hiLine" lang="hi">नाम</span></span><input name="name" maxlength="100" autocomplete="name" value=""></label><label><span>Phone<span class="hiLine" lang="hi">फ़ोन</span></span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" value=""></label><fieldset><legend><span>Will you join us?<span class="hiLine" lang="hi">क्या आप पधारेंगे?</span></span></legend><label><input type="radio" name="attending" value="yes"><span>Joyfully accept<span class="hiLine" lang="hi">सहर्ष स्वीकार</span></span></label><label><input type="radio" name="attending" value="no"><span>Regretfully decline<span class="hiLine" lang="hi">खेद सहित अस्वीकार</span></span></label><label><input type="radio" name="attending" value="maybe"><span>Not sure yet<span class="hiLine" lang="hi">अभी तय नहीं</span></span></label></fieldset><label><span>Number of guests<span class="hiLine" lang="hi">अतिथियों की संख्या</span></span><input name="guestCount" type="number" min="1" max="20" inputmode="numeric" value="1"></label><fieldset><legend><span>Which celebrations will you attend?<span class="hiLine" lang="hi">आप किन कार्यक्रमों में आएँगे?</span></span></legend><label><input type="checkbox"><span>Haldi<span class="hiLine" lang="hi">हल्दी</span></span></label><label><input type="checkbox"><span>Mehendi<span class="hiLine" lang="hi">मेहंदी</span></span></label><label><input type="checkbox"><span>Sangeet<span class="hiLine" lang="hi">संगीत</span></span></label><label><input type="checkbox"><span>Vivah<span class="hiLine" lang="hi">विवाह</span></span></label><label><input type="checkbox"><span>Reception<span class="hiLine" lang="hi">स्वागत समारोह</span></span></label></fieldset><label><span>Meal preference<span class="hiLine" lang="hi">भोजन वरीयता</span></span><select name="meal"><option value="">—</option><option value="veg">Vegetarian / शाकाहारी</option><option value="nonveg">Non-vegetarian / मांसाहारी</option><option value="jain">Jain / जैन</option></select></label><label><span>Message for the couple<span class="hiLine" lang="hi">दंपति के लिए संदेश</span></span><textarea name="message" rows="3" maxlength="1000"></textarea></label><div aria-hidden="true" style="position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden;"><label>Website<input name="website" tabindex="-1" autocomplete="off" value=""></label></div><button type="submit"><span>Send RSVP on WhatsApp<span class="hiLine" lang="hi">व्हाट्सऐप पर उत्तर भेजें</span></span></button></form></section><section class="" data-section="closing"><p>With best compliments from<span class="hiLine" lang="hi">शुभाकांक्षी</span></p><p>With love and blessings from the Sharma and Mehra families<span class="hiLine" lang="hi">शर्मा एवं मेहरा परिवार की ओर से सप्रेम</span></p><ul><li>Smt. Sunita &amp; Shri Rajesh Sharma<span class="hiLine" lang="hi">श्रीमती सुनीता एवं श्री राजेश शर्मा</span></li><li>Smt. Kavita &amp; Shri Anil Mehra<span class="hiLine" lang="hi">श्रीमती कविता एवं श्री अनिल मेहरा</span></li></ul><a href="tel:+91 98765 43210">+91 98765 43210</a><button type="button"><span>Share on WhatsApp<span class="hiLine" lang="hi">व्हाट्सऐप पर भेजें</span></span></button></section></main><footer><span>Created by Baba Saab Events<span class="hiLine" lang="hi">बाबा साब इवेंट्स द्वारा निर्मित</span></span></footer></div></div>"
`;

