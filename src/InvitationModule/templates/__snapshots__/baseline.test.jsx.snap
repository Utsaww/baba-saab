lash.com/photo-1530023367847-a683933f4172?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Photo 2"></button><button type="button" aria-label="Open Photo 3"><img src="https://images.unsplash.com/photo-1631857455684-a54a2f03665f?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Photo 3"></button><button type="button" aria-label="Open Photo 4"><img src="https://images.unsplash.com/photo-1623788452350-4c8596ff40bb?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Photo 4"></button><button type="button" aria-label="Open Photo 5"><img src="https://images.unsplash.com/photo-1595407753234-0882f1e77954?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Photo 5"></button><button type="button" aria-label="Open Photo 6"><img src="https://images.unsplash.com/photo-1514525253161-7a46d19cd819?auto=format&amp;fit=crop&amp;w=900&amp;q=80" alt="Photo 6"></button></div></section><section class="" data-section="rsvp" aria-labelledby="sec-rsvp"><h2 id="sec-rsvp"><span>RSVP</span></h2><div role="status" aria-live="polite"></div><form novalidate=""><p><span>Kindly respond by</span> Sunday, 31 January 2027</p><label><span>Name</span><input name="name" maxlength="100" autocomplete="name" value=""></label><label><span>Phone</span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" value=""></label><fieldset><legend><span>Will you join us?</span></legend><label><input type="radio" name="attending" value="yes"><span>Joyfully accept</span></label><label><input type="radio" name="attending" value="no"><span>Regretfully decline</span></label><label><input type="radio" name="attending" value="maybe"><span>Not sure yet</span></label></fieldset><label><span>Number of guests</span><input name="guestCount" type="number" min="1" max="20" inputmode="numeric" value="1"></label><fieldset><legend><span>Which celebrations will you attend?</span></legend><label><input type="checkbox"><span>Haldi</span></label><label><input type="checkbox"><span>Mehendi</span></label><label><input type="checkbox"><span>Sangeet</span></label><label><input type="checkbox"><span>Vivah</span></label><label><input type="checkbox"><span>Reception</span></label></fieldset><label><span>Meal preference</span><select name="meal"><option value="">—</option><option value="veg">Vegetarian</option><option value="nonveg">Non-vegetarian</option><option value="jain">Jain</option></select></label><label><span>Message for the couple</span><textarea name="message" rows="3" maxlength="1000"></textarea></label><div aria-hidden="true" style="position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden;"><label>Website<input name="website" tabindex="-1" autocomplete="off" value=""></label></div><button type="submit"><span>Send RSVP on WhatsApp</span></button></form></section><section class="" data-section="closing"><p>With best compliments from</p><p>With love and blessings from the Sharma and Mehra families</p><ul><li>Smt. Sunita &amp; Shri Rajesh Sharma</li><li>Smt. Kavita &amp; Shri Anil Mehra</li></ul><a href="tel:+91 98765 43210">+91 98765 43210</a><button type="button"><span>Share on WhatsApp</span></button></section></main><footer><span>Created by Baba Saab Events</span></footer></div></div>"
`;

